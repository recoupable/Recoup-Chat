# Synthetic Intelligent UI playground: local development is enabled automatically.
# Opt in only on VERCEL_ENV=preview; production deployments always remain disabled.
# This server-only flag does not require authentication or paid-service credentials.
RECOUP_INTELLIGENT_UI_PLAYGROUND=false

# Optional guarded Git replacement preview. Off when empty.
# Set only after verifying an immutable API deployment includes API #1044;
# Must be https://api-<9-character-id>-recoup.vercel.app (no aliases).
# Naming is not proof: verify the Git revision first.
# The existing API selector must point to exactly the same origin.
NEXT_PUBLIC_GUARDED_GIT_API_ORIGIN=
